{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker berisi aset statis saja (hasil `next build` di out/). Tanpa skrip:
  // request ke aset tidak dihitung sebagai pemanggilan Worker.
  "name": "mohino-portfolio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    // /proyek/portal-promo melayani proyek/portal-promo.html
    "html_handling": "auto-trailing-slash",
    // Alamat yang tidak ada memakai out/404.html ("Struk tidak ditemukan")
    "not_found_handling": "404-page"
  },
  // Disamakan dengan dashboard. Situs utama hanya di mohino.web.id (tidak ada salinan
  // di workers.dev), tapi tiap branch/PR tetap dapat Preview URL di workers.dev.
  "workers_dev": false,
  "preview_urls": true
  // Custom domain mohino.web.id dipasang lewat dashboard (Worker > Domains), bukan di
  // sini, jadi "routes" sengaja tidak diisi. `wrangler deploy` tidak menghapus domain
  // yang dipasang di dashboard. www.mohino.web.id dialihkan ke domain utama lewat
  // Redirect Rule di dashboard (template "Redirect from WWW to root").
}
